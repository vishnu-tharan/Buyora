# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Site name
NEXT_PUBLIC_SITE_NAME=Buyora

# Default currency
NEXT_PUBLIC_DEFAULT_CURRENCY=LKR

# Default locale
NEXT_PUBLIC_DEFAULT_LOCALE=en

# PayHere merchant ID (public, safe to expose)
NEXT_PUBLIC_PAYHERE_MERCHANT_ID=

# Stripe publishable key (public, safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Comma-separated trusted image hosts (include a port for local storage)
IMAGE_HOSTS=localhost:9000

# ==============================================
# Buyora API - Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=buyora_dev
DB_USERNAME=buyora
DB_PASSWORD=change_this_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT - Generate with: openssl rand -base64 64
JWT_SECRET=your-very-long-secret-key-change-this-before-using
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=30

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Object Storage (MinIO for dev)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=buyora-media
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/buyora-media

# Email
EMAIL_FROM_NAME=Buyora
EMAIL_FROM_ADDRESS=noreply@buyora.lk
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# Payment - PayHere
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# Payment - Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payment - Cash on Delivery
COD_ENABLED=true

# Public callback origins
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8080
PAYHERE_PAYMENT_URL=https://sandbox.payhere.lk/pay/checkout

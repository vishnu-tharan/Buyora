# Local Docker Compose configuration. Never commit .env.
POSTGRES_DB=buyora
POSTGRES_USER=buyora
# Required: generate separate random values before starting.
POSTGRES_PASSWORD=
JWT_SECRET=
FRONTEND_PORT=3000
BACKEND_PORT=8080
MAIL_UI_PORT=8025
# Change this when changing the backend port or using a sandbox callback tunnel.
API_PUBLIC_URL=http://localhost:8080
# Optional trusted HTTPS image hosts, comma-separated (no protocol).
IMAGE_HOSTS=
# Optional sandbox credentials; cash on delivery works without these.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Optional merchant retrieval/refund API credentials. Keep disabled until sandbox verification.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
PAYHERE_OPERATIONS_ENABLED=false
